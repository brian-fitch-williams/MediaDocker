# Copy to .env and adjust. Defaults match docker-compose.yml when unset.

# Host user/group for linuxserver containers (id -u / id -g on Linux;
# on Docker Desktop for Mac, 1000:1000 is usually fine).
PUID=1000
PGID=1000
TZ=Etc/UTC

# Volume roots (relative to compose file, or absolute paths)
CONFIG_DIR=./config
TV_DIR=./media/tv
MOVIES_DIR=./media/movies
DOWNLOADS_DIR=./downloads
PLEX_TRANSCODE_DIR=./config/plex-transcode

# Published host ports
SONARR_PORT=8989
RADARR_PORT=7878
PLEX_PORT=32400
NZBGET_PORT=6789

# One-time Plex claim token from https://plex.tv/claim (clear after first claim)
PLEX_CLAIM=

# NZBGet web UI login (change ASAP)
NZBGET_USER=nzbget
NZBGET_PASS=tegbzn6789
