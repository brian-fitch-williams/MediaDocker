# Copy to .env and adjust as needed. Defaults match docker-compose.yml.

# File ownership inside containers (match host: id -u / id -g)
PUID=1000
PGID=1000
TZ=Etc/UTC

# Host paths (relative to repo root by default)
CONFIG_DIR=./config
TV_DIR=./media/tv
MOVIES_DIR=./media/movies
DOWNLOADS_DIR=./downloads
PLEX_TRANSCODE_DIR=./config/plex-transcode

# Published ports
SONARR_PORT=8989
RADARR_PORT=7878
PLEX_PORT=32400
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920
NZBGET_PORT=6789

# Optional: one-time Plex claim token from https://plex.tv/claim
PLEX_CLAIM=

# NZBGet web UI credentials (change from defaults)
NZBGET_USER=nzbget
NZBGET_PASS=tegbzn6789
