[Unit]
Description=Headless XFCE session on DISPLAY=:1
After=xvfb-display.service
Requires=xvfb-display.service
BindsTo=xvfb-display.service

[Service]
Type=simple
# Cinnamon auto-login on :0 exports SESSION_MANAGER into the user manager;
# xfce4-session refuses to start unless that is cleared for this unit.
UnsetEnvironment=SESSION_MANAGER DESKTOP_SESSION GDMSESSION GNOME_DESKTOP_SESSION_ID XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SEAT XDG_SEAT_PATH XDG_SESSION_PATH XDG_VTNR XDG_GREETER_DATA_DIR
Environment=DISPLAY=:1
Environment=XDG_SESSION_TYPE=x11
Environment=DESKTOP_SESSION=xfce
Environment=XDG_CURRENT_DESKTOP=XFCE
Environment=XDG_SESSION_DESKTOP=xfce
ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/dbus-launch --exit-with-session /usr/bin/startxfce4
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
